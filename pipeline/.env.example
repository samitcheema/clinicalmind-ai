# ClinicalMind AI — Pipeline environment
# Copy this file to .env and fill in your Supabase credentials.
# Get these from: Supabase Dashboard → Project Settings → API

# Project URL (e.g. https://xxxxxxxxxxxx.supabase.co)
SUPABASE_URL=

# service_role secret key — NEVER expose this in the browser or commit it
# Used by seed.py and the MCP server to read/write all tables
SUPABASE_SERVICE_KEY=

# anon / public key — safe to expose in browser JS (RLS enforces read-only on clinic_stats)
# Used by the website dashboard to fetch aggregate clinic_stats
SUPABASE_ANON_KEY=

# Direct PostgreSQL connection URI — used by ensure_schema.py to create tables
# Supabase Dashboard → Project Settings → Database → Connection string → URI
# e.g. postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_URL=
